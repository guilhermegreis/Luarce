        "# Transformações - Transformação de Alargamento"
      ],
      "metadata": {
        "id": "0ZT7lz5bzBb0"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#img_in = img_colored\n",
        "img_in = cv2.imread('Cerebro-RaioX.png')\n",
        "\n",
        "#Cópia da imagem pra img de saída\n",
        "img_out = img_in.astype(np.float32)\n",
        "\n",
        "#Calcular min e max pra cada banda\n",
        "min_vals = np.min(img_out, axis=(0, 1))  #Minimo\n",
        "max_vals = np.max(img_out, axis=(0, 1))  #Maximo\n",
        "\n",
        "#Alargamento de contraste\n",
        "height, width, _ = img_out.shape\n",
        "for i in range(height):\n",
        "    for j in range(width):\n",
        "        for k in range(3):  # Iterar sobre B, G e R\n",
        "            if max_vals[k] > min_vals[k]:  # Evitar divisão por zero\n",
        "                img_out[i, j, k] = ((img_out[i, j, k] - min_vals[k]) / (max_vals[k] - min_vals[k])) * 255\n",
        "            else:\n",
        "                img_out[i, j, k] = img_out[i, j, k]\n",
        "\n",
        "# Garantir o intervalo dos valores\n",
        "img_out = np.clip(img_out, 0, 255)\n",
        "\n",
        "#Cast\n",
        "img_out = img_out.astype(np.uint8)\n",
        "\n",
        "#Img de saída\n",
        "print(\"Imagem de entrada:\")\n",
        "cv2_imshow(img_in)\n",
        "print(\"\\n\")\n",
        "#Img de entrada\n",
        "print(\"Imagem com alargamento de contraste:\")\n",
        "cv2_imshow(img_out)"

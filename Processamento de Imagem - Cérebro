    {
      "cell_type": "code",
      "source": [
        "#Caso queira testar a colorida\n",
        "#img_in = img_colored\n",
        "img_in = cv2.imread('Cerebro-RaioX.png')\n",
        "\n",
        "#Conversão para float32\n",
        "img_in = img_in.astype(np.float32)\n",
        "\n",
        "# Definir a constante c, evitando divisão por zero\n",
        "max_val = np.max(img_in)\n",
        "if max_val == 0:\n",
        "    c = 1.0\n",
        "else:\n",
        "    c = 255 / np.log(1 + max_val)\n",
        "\n",
        "#Aplicando a transofmração logaritmica\n",
        "img_out = c * np.log1p(img_in)\n",
        "\n",
        "#Garantindo os valores\n",
        "img_out = np.clip(img_out, 0, 255)\n",
        "\n",
        "#Cast\n",
        "img_out = img_out.astype(np.uint8)\n",
        "\n",
        "#Img de entrada (original)\n",
        "print(\"Imagem de entrada:\")\n",
        "cv2_imshow(img_in)\n",
        "\n",
        "#Img de saída (img logaritmizada?)\n",
        "print(\"Imagem logarítmica:\")\n",
        "cv2_imshow(img_out)"

      "cell_type": "code",
      "source": [
        "#img_in = img_colored\n",
        "img_in = cv2.imread('Cerebro-RaioX.png')\n",
        "\n",
        "#Cópia da img\n",
        "img_out = np.zeros_like(img_in, dtype=np.float32)\n",
        "\n",
        "#Definindo os parametros\n",
        "a = 7 #Nosso plano de bits, só aceita de 0 a 7\n",
        "b = 50 #Limiar de intensidade inicial\n",
        "\n",
        "#Aplicando o fatiamento limiar em cada banda\n",
        "height, width, _ = img_in.shape\n",
        "for i in range(height):\n",
        "    for j in range(width):\n",
        "        for k in range(3):\n",
        "            if img_in[i, j, k] >= b:  #Limiar inicial\n",
        "                #Extraindo o bit a\n",
        "                if (img_in[i, j, k] >> a) & 1:\n",
        "                    img_out[i, j, k] = 255\n",
        "                else:\n",
        "                    img_out[i, j, k] = 0\n",
        "            else:\n",
        "                img_out[i, j, k] = 0\n",
        "\n",
        "#Cast\n",
        "img_out = img_out.astype(np.uint8)\n",
        "\n",
        "#Img de entrada\n",
        "print(\"Imagem de entrada:\")\n",
        "cv2_imshow(img_in)\n",
        "\n",
        "#Img de saída\n",
        "print(f\"Imagem com fatiamento de plano (bit {a}, limiar {b}):\")\n",
        "cv2_imshow(img_out)"
